# Скопируйте в .env.local и заполните реальными значениями. .env.local НЕ коммитить.

# Токен Telegram-бота для приёма заявок. Создать/перевыпустить в @BotFather.
# ВАЖНО: старый токен 7862004029:... утёк в git-истории — отозвать!
TELEGRAM_BOT_TOKEN=

# ID чата/группы, куда падают заявки (например -4654232429)
